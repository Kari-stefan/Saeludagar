# Copy to .env and fill in. Never commit .env.
# Generate each secret/key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SCHOOL_NAME=
DATABASE_PATH=./data/saeludagar.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
SESSION_SECRET=
KENNITALA_ENC_KEY=
KENNITALA_HMAC_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_MAX_PER_MINUTE=30
TRUST_PROXY=0
# Development only: set to off to remove the 10-minute limit on "Fá nýjan kóða" while testing.
NEW_CODE_LIMIT=
