<%# Announces field errors to screen readers when a form comes back with errors (§11). public/js/focus-message.js moves focus here on load. -%>
<% if (Object.keys(errors).length > 0) { -%>
<div class="alert alert--error" role="alert" tabindex="-1" data-focus-on-load>
  <p><%= t('form.errorSummary') %></p>
</div>
<% } -%>
