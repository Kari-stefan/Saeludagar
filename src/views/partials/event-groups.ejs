<%#
  The front page's event list (§6): one card grid per day when sorted by date, else one grid.
  Takes `groups` ([{ day, events }], day null for an ungrouped list), `filtered` (a search or
  braut is chosen) and `level`, the heading level of the days. The cards are one level below.
-%>
<% if (filtered && groups.every((group) => group.events.length === 0)) { -%>
<p class="empty"><%= t('home.noMatches') %></p>
<% } else { -%>
<% for (const group of groups) { -%>
<% if (group.day) { -%>
<section class="day" aria-labelledby="day-<%= group.day %>">
  <h<%= level %> id="day-<%= group.day %>"><%= formatDate(group.day) %></h<%= level %>>
<% } -%>
  <% if (group.events.length === 0) { -%>
  <p class="empty"><%= t('home.noEvents') %></p>
  <% } else { -%>
  <div class="card-grid">
    <% for (const event of group.events) { -%>
    <%- include('event-card', { event, level: group.day ? level + 1 : level }) %>
    <% } -%>
  </div>
  <% } -%>
<% if (group.day) { -%>
</section>
<% } -%>
<% } -%>
<% } -%>
