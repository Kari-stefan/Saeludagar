<%
  // Error pages can render before the user and CSRF middleware have run.
  const user = locals.currentUser;
  const token = locals.csrfToken ? csrfToken() : '';
-%>
<!doctype html>
<html lang="<%= lang %>"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> · <%= siteTitle %></title>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/menu.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('site.skipToContent') %></a>
  <%#
    §6: logo, title and links in the middle, actions on the right. On narrow screens the links and
    actions move into a drawer, a <details> element that works without JavaScript.
  -%>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-logo" href="/"><img src="/img/logo.svg" alt="<%= t('site.logoAlt') %>" width="227" height="170"></a>
      <a class="site-title" href="/"><%= t('site.name') %><% if (locals.schoolName) { %><span class="visually-hidden"> – </span><span class="site-title__school"><%= schoolName %></span><% } %></a>
      <nav class="site-nav" aria-label="<%= t('nav.main') %>">
        <%- include('nav-links', { user }) %>
      </nav>
      <div class="site-header__actions">
        <%- include('header-actions', { user, token, drawer: false }) %>
      </div>
      <details class="menu">
        <summary class="menu__toggle">
          <span class="menu__when-closed"><%- include('icon', { name: 'menu' }) %><span class="visually-hidden"><%= t('nav.openMenu') %></span></span>
          <span class="menu__when-open"><%- include('icon', { name: 'close' }) %><span class="visually-hidden"><%= t('nav.closeMenu') %></span></span>
        </summary>
        <div class="menu__backdrop"></div>
        <div class="menu__panel">
          <nav aria-label="<%= t('nav.main') %>">
            <%- include('nav-links', { user }) %>
          </nav>
          <%- include('header-actions', { user, token, drawer: true }) %>
        </div>
      </details>
    </div>
  </header>
  <main id="main" class="container site-main" tabindex="-1">
