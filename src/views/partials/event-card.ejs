<%# One published event on the front page (§6). Takes `event`, with brautir and signups. -%>
<% const title = eventText(event, 'title'); -%>
<article class="event-card">
  <img class="event-card__image" src="<%= event.image_file ? `/uploads/${event.image_file}` : '/img/default-event.svg' %>" alt="<%= title %>" loading="lazy">
  <div class="event-card__body">
    <h3 class="event-card__title"><a href="/events/<%= event.id %>"><%= title %></a></h3>
    <p class="event-card__meta"><%= formatTimeRange(event.start_time, event.end_time) %> · <%= event.location %></p>
    <% if (event.brautir.length > 0) { -%>
    <p class="event-card__brautir"><%= event.brautir.join(', ') %></p>
    <% } -%>
    <ul class="badges">
      <% if (event.braut_restricted) { -%>
      <li class="badge"><%= t('events.restricted') %></li>
      <% } -%>
      <li class="badge"><%= formatFee(event.fee_isk) %></li>
      <li class="badge"><%= t('events.signups', { count: event.signups, capacity: event.capacity }) %></li>
      <% if (event.signups >= event.capacity) { -%>
      <li class="badge badge--full"><%= t('events.full') %></li>
      <% } -%>
    </ul>
  </div>
</article>
