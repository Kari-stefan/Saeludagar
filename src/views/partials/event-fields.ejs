<%#
  The event's fields (BR-20), used by the form page and the front page's dialog. Takes `values` and
  `errors`, and uses the page's `days` and `brautir`. Without errors yet, the dialog shows the ones
  the server sends next to the slots marked data-error-slot.
-%>
<% const val = (name) => values[name] ?? ''; -%>
<%- include('field', { name: 'title_is', label: t('events.form.titleIs'), value: val('title_is'), error: errors.title_is, required: true, maxlength: 200 }) %>
<%- include('field', { name: 'title_en', label: t('events.form.titleEn'), value: val('title_en'), error: errors.title_en, maxlength: 200 }) %>
<%- include('field', { name: 'description_is', label: t('events.form.descriptionIs'), value: val('description_is'), error: errors.description_is, type: 'textarea', required: true, maxlength: 5000 }) %>
<%- include('field', { name: 'description_en', label: t('events.form.descriptionEn'), value: val('description_en'), error: errors.description_en, type: 'textarea', maxlength: 5000 }) %>
<%- include('field', { name: 'host', label: t('events.host'), hint: t('events.form.hostHint'), value: val('host'), error: errors.host, required: true, maxlength: 200 }) %>

<fieldset class="fieldset">
  <legend class="field__label"><%= t('events.when') %></legend>
  <div class="field">
    <label for="field-event_date"><%= t('events.form.date') %> <span class="field__required" aria-hidden="true">*</span></label>
    <% if (errors.event_date) { -%>
    <p class="field__error" id="field-event_date-error"><%= t(errors.event_date) %></p>
    <% } -%>
    <select class="field__input field__input--short" id="field-event_date" name="event_date" required<% if (errors.event_date) { %> aria-describedby="field-event_date-error" aria-invalid="true"<% } %>>
      <% for (const day of days) { -%>
      <option value="<%= day %>"<% if (val('event_date') === day) { %> selected<% } %>><%= formatDate(day) %></option>
      <% } -%>
    </select>
  </div>
  <div class="field-row">
    <%- include('field', { name: 'start_time', label: t('events.form.start'), value: val('start_time'), error: errors.start_time, type: 'time', required: true, short: true }) %>
    <%- include('field', { name: 'end_time', label: t('events.form.end'), value: val('end_time'), error: errors.end_time, type: 'time', required: true, short: true }) %>
  </div>
</fieldset>

<%- include('field', { name: 'location', label: t('events.where'), value: val('location'), error: errors.location, required: true, maxlength: 200 }) %>
<div class="field-row">
  <%- include('field', { name: 'capacity', label: t('events.form.capacity'), value: val('capacity'), error: errors.capacity, type: 'number', min: 1, required: true, short: true }) %>
  <%- include('field', { name: 'fee_isk', label: t('events.form.fee'), hint: t('events.form.feeHint'), value: val('fee_isk'), error: errors.fee_isk, type: 'number', min: 0, short: true }) %>
</div>

<fieldset class="fieldset">
  <legend class="field__label"><%= t('events.brautir') %></legend>
  <p class="field__hint" id="brautir-hint"><%= t('events.form.brautirHint') %></p>
  <% if (errors.brautir) { -%>
  <p class="field__error" id="brautir-error"><%= t(errors.brautir) %></p>
  <% } -%>
  <div data-error-slot="brautir"></div>
  <% if (brautir.length === 0) { -%>
  <p><%= t('events.form.noBrautir') %></p>
  <% } -%>
  <% for (const name of brautir) { -%>
  <label class="checkbox"><input type="checkbox" name="brautir" value="<%= name %>"<% if ((values.brautir ?? []).includes(name)) { %> checked<% } %>> <%= name %></label>
  <% } -%>
  <label class="checkbox"><input type="checkbox" name="braut_restricted" value="1"<% if (values.braut_restricted) { %> checked<% } %> aria-describedby="brautir-hint<%= errors.brautir ? ' brautir-error' : '' %>"> <%= t('events.restricted') %></label>
</fieldset>
