<%
  const errors = locals.errors || {};
  const values = locals.values || {};
  const token = csrfToken();
-%>
<%- include('../partials/header', { pageTitle: t('pages.teachers') }) %>
<h1><%= t('pages.teachers') %></h1>
<%- include('../partials/flash') %>

<h2><%= t('admin.teachers.listHeading') %></h2>
<% if (teachers.length === 0) { -%>
<p><%= t('admin.teachers.none') %></p>
<% } else { -%>
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col"><%= t('admin.teachers.name') %></th>
        <th scope="col"><%= t('admin.teachers.email') %></th>
        <th scope="col"><%= t('admin.teachers.admin') %></th>
        <th scope="col"><%= t('admin.teachers.status') %></th>
        <th scope="col"><%= t('admin.teachers.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% for (const teacher of teachers) { const self = teacher.id === currentUser.id; -%>
      <tr>
        <td><%= teacher.name %><% if (self) { %> <%= t('admin.teachers.you') %><% } %></td>
        <td><%= teacher.email %></td>
        <td><%= teacher.isAdmin ? t('common.yes') : t('common.no') %></td>
        <td><%= teacher.active ? t('admin.teachers.active') : t('admin.teachers.inactive') %></td>
        <td>
          <form class="table__actions" method="post" action="/admin/teachers">
            <input type="hidden" name="_csrf" value="<%= token %>">
            <input type="hidden" name="id" value="<%= teacher.id %>">
            <% if (teacher.active) { -%>
            <button type="submit" class="button button--small" name="action" value="new-code"><%= t('admin.teachers.newCode') %><span class="visually-hidden">: <%= teacher.name %></span></button>
            <% } -%>
            <% if (!self) { -%>
            <% if (teacher.active) { -%>
            <button type="submit" class="button button--small button--secondary" name="action" value="deactivate"><%= t('admin.teachers.deactivate') %><span class="visually-hidden">: <%= teacher.name %></span></button>
            <% } else { -%>
            <button type="submit" class="button button--small button--secondary" name="action" value="activate"><%= t('admin.teachers.activate') %><span class="visually-hidden">: <%= teacher.name %></span></button>
            <% } -%>
            <% if (teacher.isAdmin) { -%>
            <button type="submit" class="button button--small button--secondary" name="action" value="revoke-admin"><%= t('admin.teachers.revokeAdmin') %><span class="visually-hidden">: <%= teacher.name %></span></button>
            <% } else { -%>
            <button type="submit" class="button button--small button--secondary" name="action" value="grant-admin"><%= t('admin.teachers.grantAdmin') %><span class="visually-hidden">: <%= teacher.name %></span></button>
            <% } -%>
            <% } -%>
          </form>
        </td>
      </tr>
      <% } -%>
    </tbody>
  </table>
</div>
<% } -%>

<h2 id="create"><%= t('admin.teachers.createHeading') %></h2>
<p><%= t('admin.teachers.createHelp') %></p>
<%- include('../partials/form-errors', { errors }) %>
<form class="form" method="post" action="/admin/teachers">
  <input type="hidden" name="_csrf" value="<%= token %>">
  <input type="hidden" name="action" value="create">
  <div class="field">
    <label class="field__label" for="teacher-name"><%= t('admin.teachers.name') %></label>
    <% if (errors.name) { -%>
    <p class="field__error" id="teacher-name-error"><%= t(errors.name) %></p>
    <% } -%>
    <input class="field__input" id="teacher-name" name="name" type="text" autocomplete="off" maxlength="200" required value="<%= values.name %>"<% if (errors.name) { %> aria-describedby="teacher-name-error" aria-invalid="true"<% } %>>
  </div>
  <div class="field">
    <label class="field__label" for="teacher-email"><%= t('admin.teachers.email') %></label>
    <% if (errors.email) { -%>
    <p class="field__error" id="teacher-email-error"><%= t(errors.email) %></p>
    <% } -%>
    <input class="field__input" id="teacher-email" name="email" type="email" autocomplete="off" maxlength="254" required value="<%= values.email %>"<% if (errors.email) { %> aria-describedby="teacher-email-error" aria-invalid="true"<% } %>>
  </div>
  <div class="field">
    <label class="field__label" for="teacher-kennitala"><%= t('login.kennitala') %></label>
    <p class="field__hint" id="teacher-kennitala-hint"><%= t('login.kennitalaHint') %></p>
    <% if (errors.kennitala) { -%>
    <p class="field__error" id="teacher-kennitala-error"><%= t(errors.kennitala) %></p>
    <% } -%>
    <input class="field__input" id="teacher-kennitala" name="kennitala" type="text" inputmode="numeric" autocomplete="off" maxlength="20" required
      aria-describedby="teacher-kennitala-hint<%= errors.kennitala ? ' teacher-kennitala-error' : '' %>"<% if (errors.kennitala) { %> aria-invalid="true"<% } %>>
  </div>
  <button type="submit" class="button"><%= t('admin.teachers.create') %></button>
</form>
<%- include('../partials/footer') %>
