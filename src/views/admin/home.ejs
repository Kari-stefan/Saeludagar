<%- include('../partials/header', { pageTitle: t('pages.adminHome') }) %>
<h1><%= t('pages.adminHome') %></h1>

<h2><%= t('admin.home.datesHeading') %></h2>
<dl class="facts">
  <dt><%= t('admin.settings.daysHeading') %></dt>
  <dd><%= settings.days.length > 0 ? settings.days.map((day) => formatDate(day)).join(', ') : t('admin.settings.notSet') %></dd>
  <% for (const name of ['signupOpens', 'signupCloses', 'choiceDeadline']) { -%>
  <dt><%= t(`admin.settings.${name}`) %></dt>
  <dd><%= settings[name] ? formatDateTime(settings[name]) : t('admin.settings.notSet') %></dd>
  <% } -%>
</dl>
<p><a href="/admin/settings"><%= t('admin.home.changeDates') %></a></p>

<h2><%= t('admin.home.outboxHeading') %></h2>
<ul class="stats">
  <li><%= t('admin.home.queued', { count: outbox.queued }) %></li>
  <li><%= t('admin.home.failed', { count: outbox.failed }) %></li>
</ul>

<h2><%= t('admin.home.pagesHeading') %></h2>
<ul class="link-list">
  <li><a href="/admin/settings"><%= t('pages.settings') %></a></li>
  <li><a href="/admin/import"><%= t('pages.import') %></a></li>
  <li><a href="/admin/codes"><%= t('pages.codes') %></a></li>
  <li><a href="/admin/teachers"><%= t('pages.teachers') %></a></li>
  <li><a href="/admin/events"><%= t('pages.adminEvents') %></a></li>
  <li><a href="/admin/export"><%= t('pages.export') %></a></li>
  <li><a href="/admin/purge"><%= t('pages.purge') %></a></li>
  <li><a href="/admin/audit"><%= t('pages.audit') %></a></li>
</ul>
<%- include('../partials/footer') %>
