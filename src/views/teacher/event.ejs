<% const token = csrfToken(); -%>
<%- include('../partials/header', { pageTitle: `${t('pages.eventManage')}: ${eventText(event, 'title')}` }) %>
<p class="eyebrow"><%= t('pages.eventManage') %></p>
<h1><%= eventText(event, 'title') %></h1>
<%- include('../partials/flash') %>

<dl class="facts">
  <dt><%= t('events.status') %></dt>
  <dd><%= t(`events.statusName.${event.status}`) %></dd>
  <dt><%= t('events.when') %></dt>
  <dd><%= formatDate(event.event_date) %>, <%= formatTimeRange(event.start_time, event.end_time) %></dd>
  <dt><%= t('events.where') %></dt>
  <dd><%= event.location %></dd>
  <dt><%= t('events.places') %></dt>
  <dd><%= t('events.signups', { count: event.signups, capacity: event.capacity }) %></dd>
  <dt><%= t('events.owner') %></dt>
  <dd><%= event.owner_name %></dd>
  <dt><%= t('events.coteachers.heading') %></dt>
  <dd><%= event.coteachers.length > 0 ? event.coteachers.map((teacher) => teacher.name).join(', ') : t('events.coteachers.none') %></dd>
</dl>

<div class="button-row">
  <a class="button button--secondary" href="/teacher/events/<%= event.id %>/edit"><%= t('events.edit') %></a>
  <a class="button button--secondary" href="/teacher/events/<%= event.id %>/preview"><%= t('events.preview.link') %></a>
  <% if (event.status === 'draft') { -%>
  <form method="post" action="/teacher/events/<%= event.id %>">
    <input type="hidden" name="_csrf" value="<%= token %>">
    <button type="submit" class="button" name="action" value="publish"><%= t('events.publish') %></button>
  </form>
  <% } -%>
</div>
<% if (event.status === 'draft') { -%>
<p><%= t('events.draftHelp') %></p>
<% } -%>

<h2><%= t('events.participants.heading') %></h2>
<p><%= t('events.participants.count', { count: participants.length, capacity: event.capacity }) %></p>
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col"><%= t('events.participants.name') %></th>
        <th scope="col"><%= t('events.participants.braut') %></th>
        <th scope="col"><%= t('events.participants.email') %></th>
        <th scope="col"><%= t('signups.attendance') %></th>
        <th scope="col"><span class="visually-hidden"><%= t('events.participants.actions') %></span></th>
      </tr>
    </thead>
    <tbody>
      <% for (const student of participants) { -%>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.braut || '—' %></td>
        <td><a href="mailto:<%= student.email %>"><%= student.email %></a></td>
        <td><%= student.attended ? t('signups.attendedYes') : t('signups.attendedNo') %></td>
        <td>
          <% if (!student.attended) { -%>
          <form method="post" action="/teacher/events/<%= event.id %>" class="table__actions">
            <input type="hidden" name="_csrf" value="<%= token %>">
            <input type="hidden" name="action" value="remove-student">
            <input type="hidden" name="student" value="<%= student.id %>">
            <button type="submit" class="button button--small button--secondary"><%= t('events.participants.remove') %><span class="visually-hidden">: <%= student.name %></span></button>
          </form>
          <% } -%>
        </td>
      </tr>
      <% } -%>
      <% if (participants.length === 0) { -%>
      <tr>
        <td colspan="5"><%= t('events.participants.none') %></td>
      </tr>
      <% } -%>
    </tbody>
  </table>
</div>

<h2><%= t('events.participants.add') %></h2>
<form class="form" method="get" action="/teacher/events/<%= event.id %>">
  <div class="field">
    <label class="field__label" for="student-search"><%= t('events.participants.searchLabel') %></label>
    <input class="field__input" id="student-search" name="search" type="search" maxlength="100" value="<%= studentSearch %>">
  </div>
  <button type="submit" class="button"><%= t('events.participants.search') %></button>
</form>
<% if (studentSearch) { -%>
<h3><%= t('events.participants.results') %></h3>
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col"><%= t('events.participants.name') %></th>
        <th scope="col"><%= t('events.participants.braut') %></th>
        <th scope="col"><span class="visually-hidden"><%= t('events.participants.actions') %></span></th>
      </tr>
    </thead>
    <tbody>
      <% for (const student of studentResults) { -%>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.braut || '—' %></td>
        <td>
          <form method="post" action="/teacher/events/<%= event.id %>" class="table__actions">
            <input type="hidden" name="_csrf" value="<%= token %>">
            <input type="hidden" name="action" value="add-student">
            <input type="hidden" name="student" value="<%= student.id %>">
            <input type="hidden" name="search" value="<%= studentSearch %>">
            <button type="submit" class="button button--small"><%= t('events.participants.addStudent') %><span class="visually-hidden">: <%= student.name %></span></button>
          </form>
        </td>
      </tr>
      <% } -%>
      <% if (studentResults.length === 0) { -%>
      <tr>
        <td colspan="3"><%= t('events.participants.noResults') %></td>
      </tr>
      <% } -%>
    </tbody>
  </table>
</div>
<% } -%>

<% if (access === 'owner') { -%>
<h2><%= t('events.delete.heading') %></h2>
<% if (event.attended > 0) { -%>
<p><%= t('events.delete.blocked') %></p>
<button type="button" class="button button--secondary" disabled><%= t('events.delete.button') %></button>
<% } else { -%>
<p><%= t('events.delete.help', { count: event.signups }) %></p>
<form class="form" method="post" action="/teacher/events/<%= event.id %>">
  <input type="hidden" name="_csrf" value="<%= token %>">
  <input type="hidden" name="action" value="delete">
  <div class="field">
    <label class="checkbox"><input type="checkbox" name="confirm" value="1" required> <%= t('events.delete.confirm') %></label>
  </div>
  <button type="submit" class="button button--danger"><%= t('events.delete.button') %></button>
</form>
<% } -%>
<% } -%>
<%- include('../partials/footer') %>
